rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admins: Nicole und Paul. Nur mit bestätigter E-Mail (der Login-Link bestätigt sie automatisch).
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['kontakt@nicole-ohlemueller.de', 'phoeser@web.de'];
    }

    // Seminare und Übungen: öffentlich lesbar (für den Orientierungs-Check), nur Admins schreiben.
    match /seminars/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /exercises/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Angaben der Teilnehmerinnen: jede nur ihre eigenen, Admins lesen und löschen alle.
    match /responses/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.consentAt is string;
      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    // Orientierungs-Check vor der Buchung: jede darf einen Eintrag anlegen (mit Einwilligung), nur Admins lesen.
    match /bookings/{id} {
      allow create: if request.resource.data.keys().hasOnly(['at','name','email','zustand','vals','wunsch','zeit','rec','consent','uid'])
        && request.resource.data.consent == true
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && (!('uid' in request.resource.data) || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
